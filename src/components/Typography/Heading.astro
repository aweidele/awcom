---
import type { HTMLAttributes } from "astro/types";
export interface HeadingProps extends HTMLAttributes<"h1"> {
  l?: 1 | 2 | 3 | 4 | 5 | 6;
  className?: string;
  slots?: { default: string };
}

const classes: string[] = [];

const { l = 2, className = "", ...props }: HeadingProps = Astro.props;
const headingClass = [className, classes[l - 1]].join(" ");
---

{
  l === 1 && (
    <h1 class={headingClass} {...props}>
      <slot />
    </h1>
  )
}
{
  l === 2 && (
    <h2 class={headingClass} {...props}>
      <slot />
    </h2>
  )
}
{
  l === 3 && (
    <h3 class={headingClass} {...props}>
      <slot />
    </h3>
  )
}
{
  l === 4 && (
    <h4 class={headingClass} {...props}>
      <slot />
    </h4>
  )
}
{
  l === 5 && (
    <h5 class={headingClass} {...props}>
      <slot />
    </h5>
  )
}
{
  l === 6 && (
    <h6 class={headingClass} {...props}>
      <slot />
    </h6>
  )
}
