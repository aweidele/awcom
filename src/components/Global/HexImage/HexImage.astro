---
import HexOverlay from "./HexOverlay.astro";

const { width, image, strokeColor, className = "" } = Astro.props;
const classes = ["aspect-20/17 relative"];
if( className ) classes.push(className);
---
<div class={classes.join(" ")} style={`width: ${width}px`}>
  <HexOverlay width={width} strokeColor={strokeColor} />
  <img src={image.src} class="w-full h-full object-cover clip-hex relative z-0" />
</div>