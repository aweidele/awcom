---
export interface NavLink {
  label: string;
  url: string;
  target?: string;
  active?: boolean;
}
import HamburgerLine from "./HamburgerLine.astro";
const { navItems = [] } = Astro.props;

const linkClass = "relative transition-300";
---
<button class="mobile-nav-toggle w-8 self-stretch relative">
  <HamburgerLine />
  <HamburgerLine />
  <HamburgerLine />
  <span class="sr-only">Menu</span>
</button>
<nav class="main-nav">
  <ul class="flex gap-6 font-bold md:justify-end max-md:flex-col">
    {navItems.map( ( item:NavLink ) =>(
    <li>
      <a href={item.url} class={linkClass}>
        {item.label}
        {item?.active && <span class="bg-current w-full h-1 absolute -bottom-2 left-0"></span>}
      </a>
    </li>
    ))}
  </ul>
</nav>